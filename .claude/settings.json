{
  "permissions": {
    "allow": [
      "Bash(python3 -c *)",
      "Bash(pnpm --filter website exec vue-tsc *)",
      "Bash(pnpm --filter website build *)",
      "Bash(pnpm add *)",
      "Artifact",
      "Bash(mkdir -p .claude/local/artifacts*)",
      "Bash(ls .claude/local/artifacts*)",
      "Bash(cat .claude/local/*)",
      "Bash(head)",
      "Bash(wc -l)",
      "Bash(pnpm worktree:clean*)",
      "Bash(./infrastructure/scripts/worktree-clean.sh*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-worktree-check.sh",
            "timeout": 10,
            "statusMessage": "Checking worktree status..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-stale-worktrees.sh",
            "timeout": 15,
            "statusMessage": "Cleaning up merged worktrees in the background..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-lean.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/prompt-submit-rules.sh --reset",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/prompt-submit-rules.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/context-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/quality-gate.sh",
            "timeout": 300,
            "statusMessage": "Running quality gate (lint + typecheck of changed workspaces, handover check)..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-tool-main-tree-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking edit target is inside a worktree..."
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Linear__save_issue",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-tool-linear-ticket-format.sh",
            "timeout": 10,
            "statusMessage": "Checking Linear ticket format..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-push.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Linear__save_issue",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/linear-ticket-created-title-reminder.sh",
            "timeout": 10,
            "statusMessage": "Checking for new Linear ticket..."
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000"
  },
  "cleanupPeriodDays": 30,
  "enabledPlugins": {
    "marketing@knowledge-work-plugins": false,
    "engineering@knowledge-work-plugins": false
  }
}
