# BFF base URL (used for auth and API). Default in dev: http://localhost:3000
# VITE_API_URL=http://localhost:3000

# Vite dev-server proxy target for /api, /auth, /health (dev server only — not
# used in production builds, those bake in VITE_API_URL via CI). Defaults to
# the local BFF. Set to a remote HTTPS URL (e.g. the Render deploy) to test
# against a deployed API — HTTPS dev server (self-signed cert) is enabled
# automatically so Secure session cookies persist in the browser.
# VITE_DEV_API_TARGET=http://localhost:3000

# Google Analytics 4 Measurement ID
# Get it from: analytics.google.com → Admin → Data Streams → Web
# Example: G-XXXXXXXXXX
VITE_GA_ID=
