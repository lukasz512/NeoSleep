{
  "name": "@neo/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS='--require=./vitest-crypto-polyfill.cjs' vitest run",
    "seed:demo": "tsx --env-file=../../.env ../../infrastructure/scripts/seed-demo.ts",
    "migrate": "tsx scripts/migrate.ts",
    "sync-test-schema": "tsx scripts/sync-test-schema.ts"
  },
  "dependencies": {
    "@neo/email": "workspace:*",
    "@supabase/supabase-js": "^2.110.7",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "nodemailer": "^6.9.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.0",
    "web-push": "catalog:"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "catalog:",
    "eslint": "^9.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  }
}
