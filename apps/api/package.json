{
  "name": "@neo/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS='--require=./vitest-crypto-polyfill.cjs' sh -c 'if [ -f ../../.env ]; then set -a; . ../../.env; set +a; fi; vitest run \"$@\"' --",
    "seed:demo": "tsx --env-file=../../.env ../../infrastructure/scripts/seed-demo.ts",
    "migrate": "tsx scripts/migrate.ts",
    "sync-test-schema": "tsx scripts/sync-test-schema.ts"
  },
  "dependencies": {
    "@neo/documents": "workspace:*",
    "@neo/email": "workspace:*",
    "@sparticuz/chromium": "143.0.4",
    "@supabase/supabase-js": "^2.116.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "googleapis": "^174.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "puppeteer-core": "24.34.0",
    "resend": "^6.28.0",
    "sanitize-html": "^2.17.7",
    "web-push": "catalog:"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "catalog:",
    "eslint": "catalog:",
    "supertest": "^7.0.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
