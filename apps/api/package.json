{
  "name": "@neo/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS='--require=./vitest-crypto-polyfill.cjs' sh -c 'if [ -f ../../.env ]; then set -a; . ../../.env; set +a; fi; vitest run \"$@\"' --",
    "seed:demo": "tsx --env-file=../../.env ../../infrastructure/scripts/seed-demo.ts",
    "migrate": "tsx scripts/migrate.ts",
    "sync-test-schema": "tsx scripts/sync-test-schema.ts",
    "check-tenant-schema-parity": "tsx scripts/check-tenant-schema-parity.ts",
    "seed:e2e-user": "tsx --env-file=../../.env scripts/seed-e2e-user.ts",
    "seed:qa-user": "tsx --env-file=../../.env scripts/seed-qa-user.ts"
  },
  "dependencies": {
    "@neo/documents": "workspace:*",
    "@neo/email": "workspace:*",
    "@sparticuz/chromium": "153.0.0",
    "@supabase/supabase-js": "^2.117.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "googleapis": "^182.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "puppeteer-core": "25.11.0",
    "resend": "^6.29.0",
    "sanitize-html": "^2.17.7",
    "web-push": "catalog:"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "catalog:",
    "eslint": "catalog:",
    "supertest": "^7.3.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
