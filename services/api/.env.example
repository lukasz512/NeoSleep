# =============================================================================
# NeoSleep BFF — Environment Variables
# Copy this file to .env and fill in values. Never commit .env to git.
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database ---
# Local dev (after: docker compose up -d):
DATABASE_URL=postgresql://neosleep:neosleep_local@localhost:5432/neosleep
# Production example: postgresql://user:pass@your-db-host/dbname

# --- Session ---
# Generate a strong secret: openssl rand -hex 32
SESSION_SECRET=dev-secret-change-in-production

# --- CORS / Origins ---
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173
BFF_ORIGIN=http://localhost:3000
OAUTH_REDIRECT_ORIGIN=http://localhost:5173

# --- Google OIDC ---
# Create OAuth credentials at: https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback

# --- Email (website contact form) ---
# Use a Gmail App Password — not your regular Google password
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_TO=your@gmail.com

# --- Observability ---
# Set to 1 to persist console logs to tbl_console_errors in development
ENABLE_CONSOLE_LOG_DB=0
