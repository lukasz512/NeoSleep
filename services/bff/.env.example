# Google OAuth (create credentials in Google Cloud Console)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Frontend origin (rep-app URL) for CORS and post-login redirect
# FRONTEND_URL=http://localhost:5173

# BFF public origin (must match redirect_uri sent to Google)
# BFF_ORIGIN=http://localhost:3000

# OAuth redirect_uri origin. Default: FRONTEND_URL. Use frontend URL when rep-app proxies /auth (dev).
# OAUTH_REDIRECT_ORIGIN=http://localhost:5173

# Session cookie signing (use a long random string in production)
# SESSION_SECRET=dev-secret-change-in-production

# Local Postgres (after: docker compose up -d). See foundation/docs/LOCAL_DATABASE.md
# DATABASE_URL=postgresql://neosleep:neosleep_local@localhost:5432/neosleep
