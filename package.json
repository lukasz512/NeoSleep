{
  "name": "neo-sleep-platform",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --format codeframe",
    "typecheck": "tsc -b",
    "i18n:extract": "node infra/scripts/i18n/extract.mjs",
    "i18n:unused": "node infra/scripts/i18n/unused.mjs",
    "i18n:prune": "node infra/scripts/i18n/prune.mjs",
    "build:website": "pnpm --filter @neo/website build",
    "build:app": "pnpm --filter @neo/app build",
    "lockfile:check": "./infra/scripts/lockfile-check.sh",
    "ci": "pnpm -r lint && pnpm -r typecheck && pnpm -r test",
    "prepare": "husky",
    "start": "./infra/scripts/start.sh",
    "dev": "pnpm exec concurrently --names api,app,website,telegram -c blue,green,magenta,cyan \"pnpm --filter @neo/api dev\" \"pnpm --filter @neo/app dev\" \"pnpm --filter @neo/website dev\" \"pnpm --filter @neo/telegram dev\"",
    "db:seed": "docker compose -f infra/docker-compose.yml exec -T postgres psql -U neosleep -d neosleep < services/api/migrations/009_dev_seed_2hco_4hcp.sql"
  },
  "devDependencies": {
    "vite": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.2.5",
    "typescript": "^5.6.0"
  }
}
