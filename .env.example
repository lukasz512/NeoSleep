# =============================================================================
# NeoSleep — Environment Variables (monorepo root)
# Copy to .env and fill in values. Never commit .env to git.
#
# The API server (apps/api) reads these.
# Vite (apps/*) reads VITE_* vars via envDir pointing to repo root.
# =============================================================================

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase connection string — same DB for local dev and deployed environments.
# Get it from: Supabase dashboard → Project Settings → Database → Connection string (URI, pooler)
DATABASE_URL=postgresql://user:pass@your-project.pooler.supabase.com:5432/postgres

# ─── Session ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
SESSION_SECRET=dev-secret-change-in-production

# ─── CORS / Origins ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Google OAuth (OIDC) ─────────────────────────────────────────────────────
# Create at: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorised redirect URI in Google Console.
# Backend exchanges the code — redirect goes to the frontend callback route.
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback

# ─── Multi-tenancy ───────────────────────────────────────────────────────────
DEFAULT_TENANT_SLUG=neosleep

# ─── Initial user bootstrap ──────────────────────────────────────────────────
# Set on startup for any seeded staff account with no password yet (force_password_change=true)
INITIAL_USER_PASSWORD=change-me-in-production

# ─── Email (Resend — see ADR-016) ─────────────────────────────────────────────
# Sent over Resend's HTTP API, not SMTP (SMTP ports are blocked on Render Free).
# 1. Create an API key: resend.com/api-keys
# 2. Verify a SENDING SUBDOMAIN (not the apex — e.g. send.neosleepcare.com) in
#    resend.com/domains, and add the DNS records it generates. A subdomain keeps
#    Resend's own MX/SPF/DKIM from colliding with the apex's Microsoft 365 mail.
# 3. RESEND_FROM_EMAIL can be any address on that verified subdomain — no real
#    mailbox required behind it.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@send.neosleepcare.com
RESEND_NOTIFY_TO=admin@neosleepcare.com

# ─── Web Push / VAPID ────────────────────────────────────────────────────────
# Generate once per environment: npx web-push generate-vapid-keys
# WARNING: regenerating invalidates ALL existing push subscriptions.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@neosleepcare.com

# ─── Frontend (Vite — VITE_* vars are exposed to the browser bundle) ─────────
# API URL seen from the browser. In dev, leave empty (same-origin via Vite proxy).
VITE_API_URL=
# App version injected at build time by CI (e.g. VITE_APP_VERSION=$GIT_SHA)
VITE_APP_VERSION=dev
# Must match VAPID_PUBLIC_KEY above.
# In CI this is injected from per-environment GitHub secrets:
#   VITE_VAPID_PUBLIC_KEY_DEV / _PROD → mapped to VITE_VAPID_PUBLIC_KEY at build time.
#   NOTE: no workflow currently sets this — VAPID keys aren't wired into the build yet.
VITE_VAPID_PUBLIC_KEY=

# ─── Observability ───────────────────────────────────────────────────────────
# Set to 1 to persist diagnostics to DB in non-production
ENABLE_DIAGNOSTICS_DB=0

# ─── Partners — OrthoApnea (apneadock.es) ────────────────────────────────────
# Shared NeoSleep account, used server-side only to proxy orders + resources.
# Never exposed to the frontend. See apps/api/src/services/partners/orthoapnea.ts.
ORTHOAPNEA_BASE_URL=https://apneadock.es
ORTHOAPNEA_EMAIL=
ORTHOAPNEA_PASSWORD=

# ─── Telegram Bot (apps/telegram) ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=sk-or-v1-...
# Optional: override model (default: anthropic/claude-sonnet-4-5)
# OPENROUTER_MODEL=anthropic/claude-3-haiku
