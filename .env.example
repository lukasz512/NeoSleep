# =============================================================================
# NeoSleep — Environment Variables (monorepo root)
# Copy to .env and fill in values. Never commit .env to git.
#
# The API server (apps/api) reads these.
# Vite (apps/*) reads VITE_* vars via envDir pointing to repo root.
# =============================================================================

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase connection string — same DB for local dev and deployed environments.
# Get it from: Supabase dashboard → Project Settings → Database → Connection string (URI, pooler)
DATABASE_URL=postgresql://user:pass@your-project.pooler.supabase.com:5432/postgres

# ─── Supabase Storage (signed documents, sleep study PDF attachments) ────────
# Separate from DATABASE_URL — this is the Storage API, not Postgres.
# Backend-only, never sent to the frontend. See apps/api/src/services/partnerDocuments.ts.
# Without these set, any file upload (GDPR/partner-agreement PDFs, sleep study
# attachments) fails with "Supabase Storage not configured".
# Get SUPABASE_URL from: Supabase dashboard → Project Settings → General → Project URL
# Get SUPABASE_SERVICE_KEY from: Project Settings → API Keys → Secret keys
#   (the new sb_secret_... key — NOT the Publishable key, which is client-safe/low-privilege)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
# Must exist as a PRIVATE bucket in Supabase dashboard → Storage before first use — not auto-created.
SUPABASE_DOCUMENTS_BUCKET=partner-documents

# ─── Session ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
SESSION_SECRET=dev-secret-change-in-production

# ─── CORS / Origins ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Google OAuth (OIDC) ─────────────────────────────────────────────────────
# Create at: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorised redirect URI in Google Console.
# Backend exchanges the code — redirect goes to the frontend callback route.
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback

# ─── Multi-tenancy ───────────────────────────────────────────────────────────
DEFAULT_TENANT_SLUG=neosleep

# ─── Initial user bootstrap ──────────────────────────────────────────────────
# Set on startup for any seeded staff account with no password yet (force_password_change=true)
INITIAL_USER_PASSWORD=change-me-in-production

# ─── Email (Resend — see ADR-016) ─────────────────────────────────────────────
# Sent over Resend's HTTP API, not SMTP (SMTP ports are blocked on Render Free).
# 1. Create an API key: resend.com/api-keys
# 2. Verify a SENDING SUBDOMAIN (not the apex — mail.neosleepcare.com) in
#    resend.com/domains, and add the DNS records it generates. A subdomain keeps
#    Resend's own MX/SPF/DKIM from colliding with the apex's Microsoft 365 mail.
#    mail.neosleepcare.com already exists as an A record only (no MX/SPF of its
#    own today) — Resend's records add alongside it without conflict.
# 3. RESEND_FROM_EMAIL can be any address on that verified subdomain — no real
#    mailbox required behind it. Personal-outreach emails (lead offer, partner
#    invite) show the sending rep's own name + Reply-To instead — see
#    mailer.ts's EmailSender.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@mail.neosleepcare.com
RESEND_NOTIFY_TO=admin@neosleepcare.com
# Cc'd on every signed partner-registration document email. Interim single-tenant-MVP var, not
# per-tenant config yet — see docs/stories/partner-registration-legal-documents.md.
PARTNER_DOCS_CC_EMAIL=alfred.jan@neosleepcare.com

# ─── Web Push / VAPID ────────────────────────────────────────────────────────
# Generate once per environment: npx web-push generate-vapid-keys
# WARNING: regenerating invalidates ALL existing push subscriptions.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@neosleepcare.com

# ─── Frontend (Vite — VITE_* vars are exposed to the browser bundle) ─────────
# API URL seen from the browser. In dev, leave empty (same-origin via Vite proxy).
VITE_API_URL=
# App version: VITE_APP_VERSION always comes from apps/pwa/package.json (set in
# apps/pwa/vite.config.ts; anything here is overridden). VITE_APP_BUILD and
# VITE_APP_CHANNEL (prod|dev) are set by CI in deploy-pwa.yml — leave them unset
# locally and the login page shows "Version x.y.z · LOCAL".
# VITE_APP_BUILD=
# VITE_APP_CHANNEL=
# Must match VAPID_PUBLIC_KEY above.
# In CI this is injected from per-environment GitHub secrets:
#   VITE_VAPID_PUBLIC_KEY_DEV / _PROD → mapped to VITE_VAPID_PUBLIC_KEY at build time.
#   NOTE: no workflow currently sets this — VAPID keys aren't wired into the build yet.
VITE_VAPID_PUBLIC_KEY=

# ─── Observability ───────────────────────────────────────────────────────────
# Set to 1 to persist diagnostics to DB in non-production
ENABLE_DIAGNOSTICS_DB=0

# ─── Google Calendar (public "book a call" widget) ───────────────────────────
# Books partnership calls onto a single personal Gmail calendar (not Google
# Workspace, so no built-in appointment-scheduling page — see
# apps/api/src/services/googleCalendar.ts). Optional: without it the booking
# routes just respond 503.
# Create OAuth credentials at: console.cloud.google.com → APIs & Services → Credentials
# Refresh token: run a one-time OAuth consent flow for GOOGLE_CALENDAR_ID with the
# https://www.googleapis.com/auth/calendar scope and capture the refresh_token.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=neosleepcare@gmail.com
# Always invited alongside the lead on every booked demo call, comma-separated.
GOOGLE_CALENDAR_EXTRA_ATTENDEES=lukasz.ostrowski@neosleepcare.com,alfred.jan@neosleepcare.com

# ─── Google Maps (public "find a specialist" map) ────────────────────────────
# Two SEPARATE keys, Google's recommended split — never reuse one for both:
#   - Server key: Geocoding API only, IP-restricted, never sent to the browser.
#     Resolves organization addresses to lat/lng — see apps/api/src/services/geocoding.ts.
#     Optional: without it, organizations just save without a map pin.
#   - Browser key: Maps JavaScript API only, HTTP-referrer-restricted to your
#     domains (safe to ship in the frontend bundle) — see apps/web/src/composables/useGoogleMaps.ts.
# Create both at: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_MAPS_SERVER_API_KEY=
VITE_GOOGLE_MAPS_BROWSER_API_KEY=

# ─── Partners — OrthoApnea (apneadock.es) ────────────────────────────────────
# Shared NeoSleep account, used server-side only to proxy orders + resources.
# Never exposed to the frontend. See apps/api/src/services/partners/orthoapnea.ts.
ORTHOAPNEA_BASE_URL=https://apneadock.es
ORTHOAPNEA_EMAIL=
ORTHOAPNEA_PASSWORD=

# ─── Internal job endpoints (partner status-sync, etc.) ──────────────────────
# Shared secret an external scheduler (Render Cron Job / GitHub Actions
# schedule) sends as `Authorization: Bearer <this>` to call machine-to-machine
# job routes — no user session involved. Generate: openssl rand -hex 32
# See apps/api/src/middleware/requireInternalJobSecret.ts.
INTERNAL_JOB_SECRET=

# ─── Nightly backup (NEO-62, .github/workflows/nightly-backup.yml) ───────────
# NOT read by the API. These live as GitHub Actions secrets (repo → Settings →
# Secrets and variables → Actions); they are listed here so the setup is
# discoverable and a local restore drill has the same names at hand.
# Full setup + restore procedure: docs/RUNBOOK_BACKUP_RESTORE.md
#
# Connection string pg_dump uses. Same value as DATABASE_URL today; can later
# become a dedicated read-only role. Secret.
BACKUP_DATABASE_URL=
# The workflow also uses SUPABASE_URL + SUPABASE_SERVICE_KEY (above) to copy
# every Storage bucket.
#
# age PUBLIC key the dumps are encrypted to. Not secret: it can only encrypt.
# The matching PRIVATE key (AGE-SECRET-KEY-...) is never stored here, in GitHub
# or in GCP. It lives only in Łukasz's password manager + one offline copy.
BACKUP_AGE_RECIPIENT=age1tcs9cypc2lxa7yes0racdeghtvt0rz3jpkfkgs2r9jhfuv2l4qlq99tj07
# Google Cloud project "NeoSleep Backups" (neosleep-backups), bucket in
# northamerica-south1, 30-day retention policy. Identifiers, not secrets: the
# workflow authenticates keylessly (Workload Identity Federation, dev branch only)
# and the service account can only create objects.
GCS_BACKUP_BUCKET=neosleep-backups-db
GCP_BACKUP_SERVICE_ACCOUNT=github-backup@neosleep-backups.iam.gserviceaccount.com
GCP_WIF_PROVIDER=projects/635600137353/locations/global/workloadIdentityPools/github/providers/github-repo

# ─── Telegram Bot (apps/telegram) ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=sk-or-v1-...
# Optional: override model (default: anthropic/claude-sonnet-4-5)
# OPENROUTER_MODEL=anthropic/claude-3-haiku

# ─── GitHub (Claude read-only CI/PR visibility) ──────────────────────────────
# Fine-grained PAT (github.com/settings/personal-access-tokens/new), scoped to
# this repo only, read-only on Actions + Pull requests + Contents. Lets Claude
# check CI/PR status (gh run list, gh pr checks, ...) without ever being able
# to push, create a PR, or merge — GitHub rejects any write attempt with a
# read-only token regardless of what command asks for it. Usage:
#   GH_TOKEN="$GH_READONLY_TOKEN" gh run list
GH_READONLY_TOKEN=
