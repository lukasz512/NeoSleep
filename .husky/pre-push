#!/usr/bin/env sh
# Blocks a push if the affected workspaces' tests fail. Scope is derived the
# same way .claude/hooks/quality-gate.sh does (via affected-workspaces.sh) —
# only the apps/* or packages/* workspaces this push actually touches, not a
# blanket `pnpm -r test`, so a pre-existing unrelated failure elsewhere
# doesn't block every push regardless of what changed.
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
ALL_CHANGED=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue # deleting the remote ref — nothing to check
  fi
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # New branch on the remote — diff against the merge-base with origin/dev
    # (fall back to comparing against the root commit if that's unavailable,
    # e.g. no network / origin/dev not fetched yet).
    base="$(git merge-base "$local_sha" origin/dev 2>/dev/null || true)"
    if [ -z "$base" ]; then
      base="$(git rev-list --max-parents=0 "$local_sha" | tail -1)"
    fi
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  ALL_CHANGED="$ALL_CHANGED
$(git diff --name-only "$range" -- apps packages clients 2>/dev/null || true)"
done

AFFECTED_DIRS="$(printf '%s\n' "$ALL_CHANGED" | "$REPO_ROOT/infrastructure/scripts/affected-workspaces.sh")"

if [ -z "$AFFECTED_DIRS" ]; then
  exit 0
fi

echo "pre-push: running tests for affected workspaces..."
echo "$AFFECTED_DIRS"

FILTER_ARGS=""
while IFS= read -r dir; do
  [ -n "$dir" ] && FILTER_ARGS="$FILTER_ARGS --filter ./$dir"
done <<EOF
$AFFECTED_DIRS
EOF

# shellcheck disable=SC2086
if ! pnpm $FILTER_ARGS test; then
  echo "pre-push: tests failed — fix the failures above, or push with --no-verify if you really must skip this." >&2
  exit 1
fi

# CORE-175: depcruise moved here from the Stop gate (it ran after every Claude reply).
if ! pnpm depcruise; then
  echo "pre-push: dependency rules broken (pnpm depcruise) — fix the imports above before pushing." >&2
  exit 1
fi

# NEO-182: a .vue/.css/.scss change also runs the e2e specs it can break — only the
# harness ones (no API/DB), in Chromium, ~1-3 min. NEO-132's red CI would have shown
# here. The rest of e2e stays with CI. Rule: .claude/ci-autofix.json localE2eOnUiChange.
if [ "$(jq -r '.localE2eOnUiChange' "$REPO_ROOT/.claude/ci-autofix.json" 2>/dev/null)" = "true" ]; then
  SPECS="$(printf '%s\n' "$ALL_CHANGED" | node "$REPO_ROOT/infrastructure/scripts/related-e2e.mjs" | sed 's#^apps/pwa/##')"
  if [ -n "$SPECS" ]; then
    echo "pre-push: UI changed — running related e2e specs (Chromium):"
    echo "$SPECS"
    E2E_LOG="$(mktemp)"
    # shellcheck disable=SC2086
    if ! (cd "$REPO_ROOT/apps/pwa" && pnpm exec playwright test -c playwright.harness.config.ts $SPECS) >"$E2E_LOG" 2>&1; then
      if grep -q "Executable doesn't exist" "$E2E_LOG"; then
        echo "pre-push: Playwright's Chromium isn't installed — skipped local e2e (CI still runs it). Install once: pnpm --filter @neo/pwa exec playwright install chromium" >&2
      else
        tail -60 "$E2E_LOG" >&2
        echo "pre-push: related e2e specs failed — fix them before pushing (CI would fail the same way)." >&2
        rm -f "$E2E_LOG"
        exit 1
      fi
    fi
    rm -f "$E2E_LOG"
  fi
fi
